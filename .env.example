# Copy to .env (git-ignored) or export these variables in your shell / platform.
# Never commit a real token or database password.

# Telegram bot token from @BotFather. Required: the application fails fast if unset.
BOT_TOKEN=

# HTTP port for the Ktor server (/healthz, /readyz, /openapi.yaml). Optional, defaults to 8080.
PORT=8080

# Optional PostgreSQL connection URL. Accepts a Neon/Supabase URL
# (postgresql://user:password@host/db?sslmode=require) or a JDBC URL.
# Without it the bot still plays, but /stats and the leaderboards are disabled.
DATABASE_URL=

# Optional credentials when the URL does not contain them. Leave blank for Neon/Supabase URLs
# that already include the user and password.
DATABASE_USER=
DATABASE_PASSWORD=
