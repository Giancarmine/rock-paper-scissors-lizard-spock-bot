<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!--
                Redact Telegram bot tokens from log messages and stack traces.
                tgbotapi logs the request URL on failures, for example:
                https://api.telegram.org/bot<id>:<secret>/getUpdates
            -->
            <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %replace(%msg%n%ex){'bot[0-9]+:[A-Za-z0-9_-]+', 'bot&lt;redacted&gt;'}%n</pattern>
        </encoder>
    </appender>
    <root level="info">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="io.netty" level="INFO"/>
    <logger name="dev.inmo.tgbotapi" level="INFO"/>
</configuration>
